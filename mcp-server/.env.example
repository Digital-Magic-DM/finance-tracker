# ==============================================================================
# FinTracker Remote MCP Server - Environment Variables
# For Render.com: You only need Section 1 (Firebase Admin Credentials)
# ==============================================================================

# Port to listen on (Render automatically provides PORT in production)
PORT=3000

# ------------------------------------------------------------------------------
# 1. Firebase Admin Credentials (REQUIRED for Cloud / Render.com):
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=dm-finance-tracker
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@dm-finance-tracker.iam.gserviceaccount.com
# Note: In Render, paste the private key directly from your service account JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 2. Local Testing / Admin Master Fallbacks (OPTIONAL):
# In production, each user generates their own private key (ft_mcp_<uid>_<secret>)
# inside the FinTracker web app under Settings > AI & MCP.
# ------------------------------------------------------------------------------
# FINTRACKER_AUTH_TOKEN=your-optional-admin-testing-token
# DEFAULT_USER_UID=your_optional_default_user_uid
