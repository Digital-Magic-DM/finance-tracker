# ==============================================================================
# FinTracker Remote MCP Server - Environment Variables
# Copy this file to .env for local testing or paste these variables into Render.com
# ==============================================================================

# Port to listen on (Render automatically provides PORT)
PORT=3000

# Secret token required by incoming MCP client requests (MUST be kept secret!)
# Example: Generate a random string: openssl rand -hex 24
FINTRACKER_AUTH_TOKEN=your-random-secret-token-here

# Default user ID to query if not provided in individual tool calls
DEFAULT_USER_UID=your_firebase_user_uid_here

# ------------------------------------------------------------------------------
# Firebase Admin Credentials (Option A - Recommended for Cloud/Render):
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=dm-finance-tracker
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@dm-finance-tracker.iam.gserviceaccount.com
# Note: In private key, replace actual newlines with \n when pasting into single-line env var
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Alternative Firebase Credentials (Option B - Base64 encoded Service Account JSON):
# ------------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsICJwcm9qZWN0X2lkIjogImRtLWZpbmFuY2UtdHJhY2tlciIsLi4ufQ==

# ------------------------------------------------------------------------------
# Alternative Firebase Credentials (Option C - Local Service Account File):
# ------------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
